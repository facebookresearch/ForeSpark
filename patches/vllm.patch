+def request_seed(req_id: str) -> int:
+    """The default seed of an unseeded request. Every TP rank must sample the
+    same tokens, so the seed comes from the request id, which all ranks share,
+    not from each worker's own RNG, whose state can drift between ranks."""
+    digest = hashlib.blake2b(req_id.encode(), digest_size=8).digest()
+    return int.from_bytes(digest, "little", signed=True)
+
